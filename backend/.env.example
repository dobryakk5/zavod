# Django Settings
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,fibonatty.ru,adm.fibonatty.ru

# Database (для production используйте PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/zavod

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
# Periodic tasks polling
# SCHEDULES_POLL_SECONDS=60
# MEETING_REMINDERS_POLL_SECONDS=60
# PAYMENT_REMINDERS_POLL_SECONDS=60
# CELERY_BEAT_DEBUG=False
# RAG_INDEXING_ENABLED=True
# RAG_INDEX_POLL_SECONDS=300
# RAG_INDEX_BATCH_SIZE=25
# Опционально: прокси для исходящих HTTP(S) запросов (используется Django и Celery)
# CELERY_HTTP_PROXY=http://user:password@proxy-host:3128
# CELERY_HTTPS_PROXY=http://user:password@proxy-host:3128
# CELERY_NO_PROXY=localhost,127.0.0.1
# DJANGO_HTTP_PROXY=http://user:password@proxy-host:3128
# DJANGO_HTTPS_PROXY=http://user:password@proxy-host:3128
# DJANGO_NO_PROXY=localhost,127.0.0.1

# OpenRouter API (для AI генерации контента)
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Опционально: другие AI провайдеры (для будущего использования)
# OPENAI_API_KEY=sk-your-openai-key
# STABILITY_API_KEY=your-stability-key
# RUNWAY_API_KEY=your-runway-key

# Social Media API Keys (для будущего использования)
# INSTAGRAM_ACCESS_TOKEN=your-instagram-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# YOUTUBE_API_KEY=your-youtube-api-key

# VK user auth (login on /api/auth/vk)
# VK_AUTH_APP_ID=your-vk-app-id
# VK_AUTH_APP_SECRET=your-vk-app-secret
# VK_AUTH_REDIRECT_URI=http://localhost:3000/auth/vk/callback
# VK_CALLBACK_SECRET=your-vk-callback-secret
# VK_CALLBACK_CONFIRMATION_TOKEN=your-vk-confirmation-token

# VK integrations OAuth (communities publishing flow)
# VK_CLIENT_ID=your-vk-client-id
# VK_CLIENT_SECRET=your-vk-client-secret
# VK_REDIRECT_URI=http://localhost:8000/api/vk/callback/

# Google Custom Search (CSE)
# Google_API_KEY=your-google-api-key
# CSE_ID=your-cse-id
# GOOGLE_CSE_ID=your-cse-id

# YooKassa
# YOOKASSA_SHOP_ID=your-shop-id
# YOOKASSA_SECRET_KEY=your-secret-key
# YOOKASSA_RETURN_URL=https://example.com/pay/success
# YOOKASSA_WEBHOOK_SECRET=your-webhook-secret

# Email (SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-user
# EMAIL_HOST_PASSWORD=your-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=support@fibonatty.ru
